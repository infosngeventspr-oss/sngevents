rules_version = '2';

// Ningún cliente (web/móvil) accede a Firestore directamente.
// TODO acceso a datos de estudiantes pasa por Cloud Functions (Admin SDK),
// donde se aplican el Compliance Engine y el Privacy Guard.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
